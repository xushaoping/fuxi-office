# Copy to app-b.env and replace every placeholder.
# docker compose -p fuxi-app-b -f docker-compose.multi.yml --env-file deploy/multi-instance/app-b.env up -d

INSTANCE_NAME=app-b
APP_PORT=3102
INSTANCE_HOST=app-b.example.com
FUXI_IMAGE=fuxi-dmn:local

DB_PASSWORD=replace-with-app-b-database-password
ADMIN_PASSWORD=replace-with-app-b-admin-password
JWT_SECRET=replace-with-app-b-random-secret-at-least-32-characters

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
RUST_LOG=info
APP_ENV=production
