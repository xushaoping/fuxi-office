# Copy to a private .env.production, then replace every placeholder before deployment.
# Pass it explicitly: docker compose --env-file .env.production -f docker-compose.prebuilt.yml config --quiet
# Fresh Docker installs create postgres (admin), fuxi_owner (NOLOGIN owner), fuxi (runtime).
# Existing superuser/owner runtime installations need a separately reviewed upgrade.
DB_ADMIN_PASSWORD=replace-with-a-separate-database-admin-password
APP_DB_USER=fuxi
APP_DB_OWNER=fuxi_owner
# URI passwords must use URL-safe characters (or percent-encoding in DATABASE_URL).
DB_PASSWORD=replace-with-a-strong-url-safe-runtime-password
# Native administrative tools may use DATABASE_URL; Compose constructs the internal runtime URI.
# DATABASE_URL=postgres://fuxi:<url-safe-password>@127.0.0.1:5432/fuxi_dmn
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-strong-password
BIND_ADDR=127.0.0.1:3000
APP_PORT=3000
# APP_PLATFORM=linux/amd64
# Use linux/arm64 only when the target host uses ARM64.
# FUXI_IMAGE=fuxi-dmn:release-tag
# INSTANCE_HOST=app-a.example.com
# 仅供可信 TLS 代理访问；Compose 应用端口固定绑定宿主机 loopback
TRUST_PROXY_HEADERS=true
# 浏览器无感工作量证明基础难度，建议 12-16；连续登录失败时会自适应增加最多 2 级
CAPTCHA_POW_DIFFICULTY=14
APP_ENV=production
# Build-time APT network limits. Raise update/network timeouts only if the
# selected Debian mirrors are reachable but slow from the Docker build host.
APT_UPDATE_TIMEOUT=180
APT_INSTALL_TIMEOUT=600
APT_NETWORK_TIMEOUT=20
APT_DOWNLOAD_RETRIES=2
# Docker stop_grace_period is 45s; keep the combined shutdown windows below that.
SHUTDOWN_GRACE_SECONDS=30
SHUTDOWN_DRAIN_SECONDS=2
# Emergency kill switch for read-only operations Copilot queries; unset keeps it enabled.
DECISION_COPILOT_ENABLED=true
# Optimization auto-draft modes: off (default), shadow, or draft.
# Draft mode only creates low-risk drafts; it never approves or publishes them.
# Both shadow and draft require an explicit comma-separated project allowlist.
OPTIMIZATION_AUTODRAFT_MODE=off
# OPTIMIZATION_AUTODRAFT_PROJECT_IDS=123
# Existing versions with a baseline must pass historical regression before publish.
# Set false only as an emergency compatibility override.
REQUIRE_HISTORICAL_REGRESSION_BEFORE_PUBLISH=true

# Optional LLM configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Semantic retrieval is disabled by default and falls back to keyword search.
EMBEDDING_ENABLED=false
# FUXI_EMBEDDING_ENABLED overrides EMBEDDING_ENABLED when set.
# FUXI_EMBEDDING_ENABLED=true
# Set to local for deterministic offline feature hashing, or openai-compatible (default).
FUXI_EMBEDDING_PROVIDER=openai-compatible
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_API_BASE=https://api.openai.com/v1

# Optional hard cap applied to every model response request. The value is
# sent as max_tokens (or max_completion_tokens for o1/o3); unset keeps provider defaults.
# OPENAI_MAX_COMPLETION_TOKENS=4096
# Model selection happens at startup. Task-specific OPENAI_{ANALYSIS|PLAN|DSL|CHANGE_INTENT}_MODEL
# settings take precedence over candidate selection.
# Optional model for structured optimization suggestions; defaults to the plan-task model.
# OPENAI_OPTIMIZATION_MODEL=gpt-4o-mini
# Persisted model metrics are loaded at startup; restart the service to refresh the selection.
# OPENAI_MODEL_SELECTION_POLICY=balanced_mode
# Task-specific policy overrides the global value, e.g. OPENAI_DSL_MODEL_SELECTION_POLICY=quality_first
# OPENAI_MODEL_CANDIDATES_JSON='[{"name":"gpt-4o-mini","estimated_cost_usd":0.0002,"success_rate":0.90},{"name":"gpt-4.1","estimated_cost_usd":0.01,"success_rate":0.97}]'
# Optional fail-closed ceiling per LLM request, based on configured estimated_cost_usd.
# Requires a price estimate for the primary and every permitted fallback model.
# This is not cumulative account/project billing enforcement.
# OPENAI_MAX_ESTIMATED_CALL_COST_USD=0.01
# Optional fail-closed daily token budget per project. Completed model responses
# are attributed to their finished_at database day.
# OPENAI_MAX_PROJECT_DAILY_TOKENS=200000
# Optional best-effort daily estimated response-cost budget per project.
# Completed responses use finished_at day; live reservations carry across midnight.
# Requires estimated_cost_usd for every configured primary and fallback model.
# This uses configured per-response estimates, not provider billing data.
# OPENAI_MAX_PROJECT_DAILY_ESTIMATED_COST_USD=10.00
# Optional fail-closed estimated-cost ceiling for one orchestration tree,
# including completed and in-flight child-run reservations.
# Requires estimated_cost_usd for every model that can be selected.
# OPENAI_MAX_ORCHESTRATION_ESTIMATED_COST_USD=1.00
# Optional gate before starting another Agent run when this orchestration tree
# has already observed this many prompt+completion tokens. A single in-flight
# in-flight Agent runs may exceed the threshold before usage is available.
# OPENAI_MAX_ORCHESTRATION_OBSERVED_TOKENS=250000
# Stale running orchestrations are recovered after this many heartbeat-free seconds.
# Valid range: 30-86400; default: 120.
# AGENT_ORCHESTRATION_STALE_AFTER_SECONDS=120
# Optional project drift webhook delivery. Configure an exact comma-separated
# hostname allowlist and a private random signing key (at least 32 bytes).
# DRIFT_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# DRIFT_WEBHOOK_SIGNING_SECRET=<at-least-32-random-bytes>
# Optional project-stable A/B experiment for non-high-risk requirement analysis.
# Set both name and treatment model to enable; treatment share defaults to 50%.
# Results are available to admins at GET /api/admin/model-experiments.
# OPENAI_ANALYSIS_EXPERIMENT_NAME=analysis-model-v1
# OPENAI_ANALYSIS_EXPERIMENT_MODEL=gpt-4.1
# OPENAI_ANALYSIS_EXPERIMENT_TREATMENT_PERCENT=20
# Optional complexity-specific analysis models; unset values use OPENAI_ANALYSIS_MODEL.
# OPENAI_ANALYSIS_SIMPLE_MODEL=gpt-4.1-mini
# OPENAI_ANALYSIS_COMPLEX_MODEL=gpt-4.1
# Optional low-cost single-model route for simple DSL generation; complex requests still use consensus.
# OPENAI_DSL_SIMPLE_MODEL=gpt-4.1-mini
# Optional treatment overrides used only when the matching control complexity model is configured.
# Otherwise the common OPENAI_ANALYSIS_EXPERIMENT_MODEL is used for that treatment complexity.
# OPENAI_ANALYSIS_EXPERIMENT_SIMPLE_MODEL=gpt-4.1-mini
# OPENAI_ANALYSIS_EXPERIMENT_COMPLEX_MODEL=gpt-4.1
# Optional project-stable A/B experiment for non-high-risk decision planning.
# Use an experiment name unique across tasks; results share the admin experiment report.
# Optional low-cost model for low-risk simple planning; high-risk projects use the standard model.
# OPENAI_PLAN_SIMPLE_MODEL=gpt-4.1-mini
# OPENAI_PLAN_EXPERIMENT_NAME=plan-model-v1
# OPENAI_PLAN_EXPERIMENT_MODEL=gpt-4.1
# OPENAI_PLAN_EXPERIMENT_TREATMENT_PERCENT=20
# Optional project-stable A/B experiments for DSL generation and change intent.
# These only apply to non-high-risk projects. Use names unique across all tasks.
# OPENAI_DSL_EXPERIMENT_NAME=dsl-model-v1
# OPENAI_DSL_EXPERIMENT_MODEL=gpt-4.1
# OPENAI_DSL_EXPERIMENT_TREATMENT_PERCENT=20
# OPENAI_CHANGE_INTENT_EXPERIMENT_NAME=change-intent-model-v1
# OPENAI_CHANGE_INTENT_EXPERIMENT_MODEL=gpt-4.1
# OPENAI_CHANGE_INTENT_EXPERIMENT_TREATMENT_PERCENT=20
# Up to three fallback models are tried in order after the selected model.
# OPENAI_FALLBACK_MODELS=gpt-4.1-mini,gpt-4o-mini,deepseek-chat
# Override fallback chain for a task, e.g. OPENAI_DSL_FALLBACK_MODELS=gpt-4.1-mini,gpt-4o-mini
# Maximum number of in-flight HTTP requests per model across fallback and vote agents.
# OPENAI_MODEL_MAX_CONCURRENCY=4

# Optional provider-specific request options
# OPENAI_REQUEST_OPTIONS_JSON='{"enable_thinking":false}'

# Optional task models/policies/request options/fallbacks; leave UNSET to inherit.
# Empty strings are not the same as unset, especially for numeric budgets.
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini
# OPENAI_PLAN_MODEL=gpt-4o-mini
# OPENAI_DSL_MODEL=gpt-4o-mini
# OPENAI_CHANGE_INTENT_MODEL=gpt-4o-mini
# OPENAI_ANALYSIS_MODEL_SELECTION_POLICY=balanced_mode
# OPENAI_PLAN_MODEL_SELECTION_POLICY=balanced_mode
# OPENAI_DSL_MODEL_SELECTION_POLICY=quality_first
# OPENAI_CHANGE_INTENT_MODEL_SELECTION_POLICY=balanced_mode
# OPENAI_ANALYSIS_REQUEST_OPTIONS_JSON='{"enable_thinking":false}'
# OPENAI_PLAN_REQUEST_OPTIONS_JSON='{"enable_thinking":false}'
# OPENAI_DSL_REQUEST_OPTIONS_JSON='{"enable_thinking":false}'
# OPENAI_CHANGE_INTENT_REQUEST_OPTIONS_JSON='{"enable_thinking":false}'
# OPENAI_ANALYSIS_FALLBACK_MODELS=gpt-4o-mini
# OPENAI_PLAN_FALLBACK_MODELS=gpt-4o-mini
# OPENAI_DSL_FALLBACK_MODELS=gpt-4o-mini
# OPENAI_CHANGE_INTENT_FALLBACK_MODELS=gpt-4o-mini

# Clean Docker builds download official Binaryen 132 and verify the architecture's SHA256.
# A custom archive (filename under script/), URL, or version MUST include its own SHA256.
# BINARYEN_ARCHIVE=custom-linux-binaryen.tar.gz
# BINARYEN_DOWNLOAD_URL=https://trusted.example.com/binaryen.tar.gz
# BINARYEN_VERSION=132
# BINARYEN_SHA256=<64-hex-digest>
