.git
.github
.claude
.codex
.agents
.DS_Store

# Build outputs and local caches
target
dist
release
.docker-cache
*.log
*.pdf

# Documentation and generated artifacts are not needed by Dockerfile COPY
docs
backups
deploy

# Default builds download checksum-verified Binaryen. Allow the documented
# local amd64 archive; other local archives need an exact exception and SHA256.
script/*.tar.gz
!script/binaryen-version_132-x86_64-linux.tar.gz

# Local environment files
.env
.env.*
!.env.example
