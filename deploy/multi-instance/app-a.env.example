# Copy to app-a.env and replace every placeholder.
# docker compose -p fuxi-app-a -f docker-compose.multi.yml --env-file deploy/multi-instance/app-a.env up -d

INSTANCE_NAME=app-a
APP_PORT=3101
INSTANCE_HOST=app-a.example.com
FUXI_IMAGE=fuxi-dmn:local

DB_PASSWORD=replace-with-app-a-database-password
ADMIN_PASSWORD=replace-with-app-a-admin-password
JWT_SECRET=replace-with-app-a-random-secret-at-least-32-characters

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
RUST_LOG=info
APP_ENV=production
